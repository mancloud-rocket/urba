PORT=8787

# --- Base de datos ---
# Opcion A (recomendada si el password tiene $, @, # u otros simbolos):
# SUPABASE_DB_HOST=aws-1-us-east-2.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres.TU_PROJECT_REF
# SUPABASE_DB_PASSWORD="tu-password-aqui"
# SUPABASE_DB_NAME=postgres
#
# Opcion B: URI completa (password con simbolos debe ir URL-encoded: $ -> %24)
# DATABASE_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#
# Local SQLite: deja todo vacio
DATABASE_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres
# DATABASE_SSL=false  # solo si conectas a Postgres local sin SSL

# LOG_LEVEL=debug  # debug | info | warn | error

# --- OpenAI (agente IA) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- WhatsApp (Evolution API) ---
# Local: http://localhost:8080
# Render + Evolution en tu PC: URL de ngrok (ngrok http 8080)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=urba-local-secret
EVOLUTION_INSTANCE=urba
# EVOLUTION_WEBHOOK_SECRET=opcional-mismo-que-api-key

# Numeros autorizados (sin +, separados por coma). Ej: 34600484723,59894759760
ALLOWED_PHONES=34600484723,59894759760

# --- Solo desarrollo local SQLite ---
DATABASE_PATH=./data/balde.db

# Forzar re-seed (borra datos y vuelve a cargar seed.json)
# FORCE_SEED=1
