# Clave global de Evolution (header apikey en todas las requests)
AUTHENTICATION_API_KEY=urba-local-secret

# URL publica de Evolution (localhost para prueba; ngrok si Render debe llamar aca)
SERVER_URL=http://localhost:8080

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:evolution@postgres:5432/evolution?schema=public

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379

# Instancia URBA
EVOLUTION_INSTANCE=urba

# Webhook URBA: server local en el host (Windows/Mac Docker)
URBA_WEBHOOK_URL=http://host.docker.internal:8787/api/whatsapp/webhook

# Si URBA corre en Render, usa:
# URBA_WEBHOOK_URL=https://urba.onrender.com/api/whatsapp/webhook
