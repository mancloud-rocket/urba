{
  "name": "balde",
  "version": "1.0.0",
  "private": true,
  "description": "BALDE - Agente de cuentas corrientes para materiales de construccion",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev --prefix server",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "migrate": "python scripts/migrate_from_excel.py",
    "seed": "npm run seed --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
